# Set LLM_MODE=mock for deterministic local development and automated tests.
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Framework /v1 integration API. Keep disabled for the local Demo.
FRAMEWORK_AUTH_MODE=disabled
# Enable api_key mode with a secret stored only in your deployment environment:
# FRAMEWORK_API_KEYS_JSON=[{"principal_id":"partner_app","api_key":"replace-with-a-secret-at-least-16-chars","merchant_ids":["star_select"]}]

# Optional single webhook outbox target. Events are HMAC-SHA256 signed and can be replayed via /v1/events/{event_id}/replay.
# FRAMEWORK_WEBHOOK_URL=https://partner.example/webhooks/retail-agent
# FRAMEWORK_WEBHOOK_SECRET=replace-with-a-secret-at-least-16-chars
